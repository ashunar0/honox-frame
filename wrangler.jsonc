{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "honox-frame",
  "main": "./dist/index.js",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "honox-frame-showcase",
      "database_id": "1adcd4f3-e20b-4698-99db-c573dc088db9",
      "migrations_dir": "./db/migrations"
    }
  ]
}